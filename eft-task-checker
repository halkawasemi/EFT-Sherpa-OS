<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EFT Task Item Tracker | Sherpa Database</title>
    <meta name="description" content="Escape from Tarkovのトレーダー別タスク必要アイテム管理ツール。最新のAPIデータに基づき、個別に進捗を記録。">
    <!-- Tailwind CSS & Font Awesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@400;700&display=swap');
        
        body {
            background-color: #0d0d0d;
            color: #e0e0e0;
            font-family: 'Noto Sans JP', sans-serif;
        }
        .tarkov-font { font-family: 'Bebas Neue', cursive; }
        .accent-gold { color: #9a8866; }
        .bg-tarkov-card { background-color: #1a1a1a; border: 1px solid #333; }
        .bg-tarkov-dark { background-color: #111; }
        .checked-item { opacity: 0.4; filter: grayscale(1); text-decoration: line-through; }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0d0d0d; }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #9a8866; }
    </style>
</head>
<body class="min-h-screen pb-10">

    <!-- Header -->
    <header class="bg-black border-b border-zinc-800 p-4 sticky top-0 z-50 shadow-2xl">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
            <h1 class="text-3xl tarkov-font tracking-widest accent-gold">
                <i class="fa-solid fa-crosshairs mr-2"></i>TASK ITEM CHECKER
            </h1>
            <div class="flex flex-wrap justify-center gap-2" id="trader-filters">
                <!-- Trader Filters will be injected here -->
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto mt-6 px-4">
        
        <!-- Search & Stats -->
        <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
            <div class="relative w-full md:w-96">
                <i class="fa-solid fa-search absolute left-3 top-3 text-zinc-500"></i>
                <input type="text" id="task-search" placeholder="タスク名やアイテム名で検索..." 
                    class="w-full bg-zinc-900 border border-zinc-700 rounded p-2 pl-10 focus:outline-none focus:border-yellow-700 transition-colors">
            </div>
            <div class="text-sm text-zinc-400" id="progress-stats">
                取得中...
            </div>
            <button onclick="resetProgress()" class="text-xs bg-red-900/30 hover:bg-red-900/60 border border-red-800 px-3 py-1 rounded transition-all">
                進捗リセット
            </button>
        </div>

        <!-- Task Grid -->
        <div id="task-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Loader -->
            <div class="col-span-full flex justify-center py-20">
                <div class="animate-spin text-4xl accent-gold"><i class="fa-solid fa-circle-notch"></i></div>
            </div>
        </div>
    </main>

    <script>
        /**
         * EFT Task Item Checker - Core Logic
         */
        let allTasks = [];
        let completedItems = JSON.parse(localStorage.getItem('eft_completed_items') || '{}');
        let currentTrader = 'all';

        const TRADERS = ["Prapor", "Therapist", "Skier", "Peacekeeper", "Mechanic", "Ragman", "Jaeger", "Lightkeeper"];

        // 1. API Data Fetching (GraphQL)
        async function fetchTaskData() {
            const query = `
            {
                tasks {
                    id
                    name
                    trader { name id }
                    minPlayerLevel
                    objectives {
                        id
                        type
                        description
                        ... on TaskObjectiveItem {
                            count
                            item { id name iconLink }
                            foundInRaid
                        }
                    }
                }
            }`;

            try {
                const response = await fetch('https://api.tarkov.dev/graphql', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ query })
                });
                const data = await response.json();
                // アイテム納品・発見タスクのみを抽出
                allTasks = data.data.tasks.filter(task => 
                    task.objectives.some(obj => obj.item !== undefined)
                );
                renderFilters();
                renderTasks();
            } catch (error) {
                console.error("API Fetch Error:", error);
                document.getElementById('task-container').innerHTML = `<p class="col-span-full text-center text-red-500">データの取得に失敗しました。時間をおいて再度お試しください。</p>`;
            }
        }

        // 2. Render Functions
        function renderFilters() {
            const container = document.getElementById('trader-filters');
            let html = `<button onclick="filterTrader('all')" class="px-3 py-1 rounded text-sm transition ${currentTrader === 'all' ? 'bg-yellow-700 text-white' : 'bg-zinc-800 hover:bg-zinc-700'}">ALL</button>`;
            
            TRADERS.forEach(t => {
                html += `<button onclick="filterTrader('${t}')" class="px-3 py-1 rounded text-sm transition ${currentTrader === t ? 'bg-yellow-700 text-white' : 'bg-zinc-800 hover:bg-zinc-700'}">${t.toUpperCase()}</button>`;
            });
            container.innerHTML = html;
        }

        function renderTasks() {
            const container = document.getElementById('task-container');
            const searchTerm = document.getElementById('task-search').value.toLowerCase();
            
            const filtered = allTasks.filter(task => {
                const matchesTrader = currentTrader === 'all' || task.trader.name === currentTrader;
                const matchesSearch = task.name.toLowerCase().includes(searchTerm) || 
                                    task.objectives.some(obj => obj.item?.name.toLowerCase().includes(searchTerm));
                return matchesTrader && matchesSearch;
            });

            container.innerHTML = filtered.map(task => `
                <div class="bg-tarkov-card p-4 rounded shadow-lg flex flex-col">
                    <div class="flex justify-between items-start mb-2 border-b border-zinc-800 pb-2">
                        <div>
                            <span class="text-[10px] text-zinc-500 uppercase tracking-tighter">${task.trader.name}</span>
                            <h3 class="text-md font-bold accent-gold leading-tight">${task.name}</h3>
                        </div>
                        <span class="text-[10px] bg-zinc-800 px-2 py-1 rounded text-zinc-400">LV.${task.minPlayerLevel || 1}</span>
                    </div>
                    <div class="space-y-2 mt-2 flex-grow">
                        ${task.objectives.filter(obj => obj.item).map(obj => {
                            const uniqueKey = `${task.id}_${obj.id}`;
                            const isChecked = completedItems[uniqueKey];
                            return `
                                <div class="flex items-center gap-3 p-2 bg-black/40 rounded hover:bg-black/60 transition-colors cursor-pointer ${isChecked ? 'checked-item' : ''}" 
                                     onclick="toggleItem('${uniqueKey}')">
                                    <img src="${obj.item.iconLink}" alt="" class="w-8 h-8 object-contain bg-zinc-800 rounded">
                                    <div class="flex-grow text-xs">
                                        <div class="font-medium">${obj.item.name}</div>
                                        <div class="text-[10px] text-zinc-500">
                                            必要数: ${obj.count} ${obj.foundInRaid ? '<span class="text-orange-600 font-bold ml-1">FiR必須</span>' : ''}
                                        </div>
                                    </div>
                                    <div class="w-5 h-5 border border-zinc-600 rounded flex items-center justify-center">
                                        ${isChecked ? '<i class="fa-solid fa-check text-yellow-600"></i>' : ''}
                                    </div>
                                </div>
                            `;
                        }).join('')}
                    </div>
                </div>
            `).join('');

            updateStats();
        }

        // 3. Logic Functions
        function toggleItem(key) {
            if (completedItems[key]) {
                delete completedItems[key];
            } else {
                completedItems[key] = true;
            }
            localStorage.setItem('eft_completed_items', JSON.stringify(completedItems));
            renderTasks();
        }

        function filterTrader(trader) {
            currentTrader = trader;
            renderFilters();
            renderTasks();
        }

        function updateStats() {
            const totalItems = allTasks.reduce((acc, task) => acc + task.objectives.filter(o => o.item).length, 0);
            const checkedCount = Object.keys(completedItems).length;
            document.getElementById('progress-stats').innerHTML = `
                <span class="accent-gold font-bold">${checkedCount}</span> / ${totalItems} アイテム完了
            `;
        }

        function resetProgress() {
            if(confirm('全てのチェックをリセットしますか？')) {
                completedItems = {};
                localStorage.removeItem('eft_completed_items');
                renderTasks();
            }
        }

        // Event Listeners
        document.getElementById('task-search').addEventListener('input', renderTasks);

        // Init
        fetchTaskData();
    </script>
</body>
</html>